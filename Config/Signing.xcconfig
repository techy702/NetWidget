// Committed defaults: ad-hoc signing, so the project builds and tests without a Developer ID.
// For the signed release build, copy Signing.local.xcconfig.example to Signing.local.xcconfig
// (gitignored) and fill in your Team ID. Nothing here is a secret, it just stays local by choice.
CODE_SIGN_STYLE = Manual
CODE_SIGN_IDENTITY = -
DEVELOPMENT_TEAM =

#include? "Signing.local.xcconfig"
